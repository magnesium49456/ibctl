# Generated by tools/generate_configs.py — DO NOT EDIT
# ibctl environment configuration
# Copy to .env and fill in your credentials.
# NEVER commit .env to version control.

# Authentication
TWS_USERID=your_username
TWS_PASSWORD=your_password
TRADING_MODE=paper                # live | paper | both

# Paper mode (only needed for TRADING_MODE=both)
TWS_USERID_PAPER=your_paper_username
TWS_PASSWORD_PAPER=your_paper_password

# Two-factor authentication
TWOFACTOR_CODE=                 # TOTP secret for non-IB-Key auto-login
TOTP_PROVIDER=builtin           # builtin | oathtool
TWOFA_DEVICE=IB Key               # or "Mobile Authenticator app"
TWOFA_TIMEOUT_ACTION=restart       # restart | exit
TWOFA_EXIT_INTERVAL=120
RELOGIN_AFTER_TWOFA_TIMEOUT=yes

# HITL 2FA backoff (uncomment to override TOML defaults)
# Required ONLY if HITL strategy uses ntfy_callback (signed one-shot URLs).
# Generate with: openssl rand -hex 32
IBCTL_NTFY_ACTION_SIGNING_KEY=
# IBCTL_TWOFA_MAX_IMMEDIATE_ATTEMPTS=3
# IBCTL_TWOFA_ON_TIMEOUT=restart_then_hitl     # | restart_forever | hitl_immediately
# IBCTL_TWOFA_STRATEGY=periodic                 # | disabled | ntfy_callback | both
# IBCTL_TWOFA_INTERVALS_MINUTES=60              # comma-separated for backoff curve
# IBCTL_TWOFA_CALLBACK_VALID_HOURS=12
# IBCTL_TWOFA_COUNTER_RESET=any_reach           # | stable
# IBCTL_TWOFA_STABLE_SECS=300
# IBCTL_TWOFA_COLD_RESTART_PREEMPTS_HITL=true
# IBCTL_TWOFA_NTFY_SEND_RETRIES=1

# Session
EXISTING_SESSION_DETECTED_ACTION=primary

# API configuration (applied after login)
TWS_ACCEPT_INCOMING=accept
TWS_TRUSTED_IPS=127.0.0.1
TWS_MASTER_CLIENT_ID=50
READ_ONLY_API=no
BYPASS_WARNING=yes
ALLOW_BLIND_TRADING=no
TWS_API_INSTRUMENT_TIMEZONE=UTC format
# DISMISS_PASSWORD_EXPIRY_WARNING=yes
# ACCEPT_BID_ASK_LAST_SIZE_DISPLAY_UPDATE_NOTIFICATION=ignore
# CONFIRM_CRYPTO_CURRENCY_ORDERS=manual

# Scheduling
AUTO_RESTART_TIME=05:05 PM
TWS_COLD_RESTART=09:00
SAVE_TWS_SETTINGS_AT=08:00 12:30 17:30

# Gateway
JAVA_HEAP_SIZE=768
IBCTL_LIVE_API_PORT=4001
IBCTL_PAPER_API_PORT=4002
IBCTL_LIVE_SOCAT_PORT=4003
IBCTL_PAPER_SOCAT_PORT=4004
TZ=America/New_York

# VNC (optional — set password to enable)
VNC_SERVER_PASSWORD=

# Logging
RUST_LOG=ibctl=info

# TCP port probe during Connected (uncomment to override TOML defaults)
# IBCTL_API_PORT_PROBE_INTERVAL_SECS=5          # 0 = disable TCP probe
# IBCTL_API_PORT_PROBE_FAILS_BEFORE_REVOKE=3
